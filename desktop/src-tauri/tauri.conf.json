{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "old-country",
  "version": "0.1.0",
  "identifier": "dev.wiormiw.oldcountry",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "old-country",
        "width": 1240,
        "height": 800,
        "minWidth": 400,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.ytimg.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Native player for the old-country music server",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
