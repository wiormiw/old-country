# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Database password. Letters and digits only: it goes inside a connection string.
POSTGRES_PASSWORD=change-me

# Your music, on the server. Scanned for the library; YouTube downloads land in "YouTube Music" inside it.
MUSIC_DIR=/srv/music

# The user and group that own MUSIC_DIR (run `id` on the server). The API runs as them.
PUID=1000
PGID=1000

# Port the API listens on, on the server. Set the desktop app's server address to http://<server>:<this>.
API_PORT=5000

# yt-dlp release to build in (https://github.com/yt-dlp/yt-dlp/releases). When YouTube playback or
# search breaks, bump this and run: docker compose up -d --build
YTDLP_VERSION=2026.10.26

# Where the API sends its logs, traces and metrics (OTLP). Leave empty to turn telemetry off.
#   The observability stack (docker compose --profile observability up -d): http://alloy:4317
#   The Aspire dashboard instead (docker compose --profile dashboard up -d):  http://dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# The environment label on all telemetry (deployment.environment.name).
DEPLOYMENT_ENVIRONMENT=production

# Observability stack: Grafana on http://<server>:<GRAFANA_PORT>, user "admin".
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-too
# How long each store keeps data. Disk use grows with these values.
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
TEMPO_RETENTION=168h

# Aspire dashboard (profile "dashboard").
DASHBOARD_PORT=18888
