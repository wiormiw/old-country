# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Database password. Letters and digits only: it goes inside a connection string.
POSTGRES_PASSWORD=change-me

# Your music, on the server. Scanned for the library; YouTube downloads land in "YouTube Music" inside it.
MUSIC_DIR=/srv/music

# The user and group that own MUSIC_DIR (run `id` on the server). The API runs as them.
PUID=1000
PGID=1000

# Port the API listens on, on the server. Set the desktop app's server address to http://<server>:<this>.
API_PORT=5000

# yt-dlp release to build in (https://github.com/yt-dlp/yt-dlp/releases). When YouTube playback or
# search breaks, bump this and run: docker compose up -d --build
YTDLP_VERSION=2026.10.26

# Logs and traces in the Aspire dashboard (docker compose --profile dashboard up -d). Leave empty to turn off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889
DASHBOARD_PORT=18888
