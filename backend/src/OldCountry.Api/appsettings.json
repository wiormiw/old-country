{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Library": {
    "Roots": [],
    "RescanInterval": "06:00:00",
    "ScanOnStartup": true
  },
  "YouTubeMusic": {
    "YtDlpPath": "yt-dlp",
    "JsRuntime": "node",
    "CookiesFile": null,
    "DownloadFolder": null,
    "AudioFormat": "opus",
    "StreamCacheFolder": null,
    "StreamCacheMaxMegabytes": 2048,
    "CommandTimeout": "00:05:00"
  }
}
