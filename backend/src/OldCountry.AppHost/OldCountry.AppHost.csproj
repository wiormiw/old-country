<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <!-- Local development: a persistent Postgres container, the API, and the Aspire dashboard. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Keeps the Postgres password for development (Parameters:postgres-password). See Program.cs. -->
    <UserSecretsId>12967a33-34f5-4bf4-87e7-a445f40276a8</UserSecretsId>
    <!-- Start it with `dotnet run`. This AppHost does not need the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OldCountry.Api\OldCountry.Api.csproj" />
  </ItemGroup>
</Project>
